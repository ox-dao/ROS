<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Copyright>gt</Copyright>
		<AssemblyTitle>OX</AssemblyTitle>
		<Version>3.0.0</Version>
		<Authors>gt</Authors>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>ox.tablet.core</AssemblyName>
		<PackageId>ox.tablet.core</PackageId>
		<PackageTags></PackageTags>
		<PackageProjectUrl></PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl></RepositoryUrl>
		<RootNamespace>OX.Tablet</RootNamespace>
		<Company>gt</Company>
		<Description>ox.tablet.core</Description>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Mnemonics\**" />
		<Compile Remove="Models\Mining\**" />
		<Compile Remove="Models\StakingMining\**" />
		<Compile Remove="Persistence\**" />
		<Compile Remove="Properties\**" />
		<EmbeddedResource Remove="Mnemonics\**" />
		<EmbeddedResource Remove="Models\Mining\**" />
		<EmbeddedResource Remove="Models\StakingMining\**" />
		<EmbeddedResource Remove="Persistence\**" />
		<EmbeddedResource Remove="Properties\**" />
		<None Remove="Mnemonics\**" />
		<None Remove="Models\Mining\**" />
		<None Remove="Models\StakingMining\**" />
		<None Remove="Persistence\**" />
		<None Remove="Properties\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Extensions\EthHelper.cs" />
	  <Compile Remove="Extensions\MutualLockHelper.cs" />
	  <Compile Remove="Extensions\WebHostHelper.cs" />
	  <Compile Remove="Providers\BlockIndex-Agent.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
		<PackageReference Include="Akka" Version="1.5.30" />
		<PackageReference Include="Nethereum.ABI" Version="6.0.0" />
		<PackageReference Include="Nethereum.Accounts" Version="6.0.0" />
		<PackageReference Include="Nethereum.Hex" Version="6.0.0" />
    <PackageReference Include="Nethereum.Signer" Version="6.0.0" />
		<PackageReference Include="Nethereum.Web3" Version="6.0.0" />
		<PackageReference Include="Nethereum.Signer" Version="6.0.0" />
		<PackageReference Include="SunnyUI" Version="3.9.8" />
		<PackageReference Include="SunnyUI.Common" Version="3.9.8" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="ox">
	    <HintPath>..\libs\ox.dll</HintPath>
	  </Reference>
	  <Reference Include="ox.casino.core">
	    <HintPath>..\libs\ox.casino.core.dll</HintPath>
	  </Reference>
	  <Reference Include="ox.invest.core">
	    <HintPath>..\libs\ox.invest.core.dll</HintPath>
	  </Reference>
	  <Reference Include="ox.vm">
	    <HintPath>..\libs\ox.vm.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="BaseContentPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	</ItemGroup>


</Project>
